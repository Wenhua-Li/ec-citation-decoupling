{
 "task": "Gate 1 paper-level stratified bootstrap of the reverse-forward asymmetry gap",
 "script": "research/nature/paper_bootstrap_asymmetry.py",
 "input": {
  "database": "db/ec_papers.db",
  "access": "SQLite read-only URI (ecdb.raw_sql default); no writes",
  "meta_sql": "SELECT p.accession_no AS acc, p.pub_year AS y, p.source AS src, d.label AS lab, d.tier AS tier, d.confidence AS conf FROM papers p JOIN paper_domain d ON d.accession_no = p.accession_no",
  "refs_sql": "SELECT r.accession_no AS acc, COUNT(DISTINCT CASE WHEN d.label='EC' THEN pc.accession_no END) AS n_ec, COUNT(DISTINCT CASE WHEN d.label='NON_EC' THEN pc.accession_no END) AS n_non, COUNT(DISTINCT r.cited_doi) AS n_refs_doi FROM paper_refs_out r LEFT JOIN papers pc ON pc.doi = r.cited_doi LEFT JOIN paper_domain d ON d.accession_no = pc.accession_no WHERE r.cited_doi IS NOT NULL GROUP BY r.accession_no",
  "paper_cit_edges_used": false,
  "cross_check_inputs": [
   "research/nature/out/stable8_merged.json (read-only)",
   "research/nature/out/bidirectional_asymmetry.json (read-only)"
  ]
 },
 "disclaimer": {
  "zh": "本输出是论文级分层 bootstrap：在 方向×年份×刊源 分层内对引用论文有放回重抽，每篇论文的到EC/到NON边数与 DOI 参考文献分母一起被重抽，边不作为独立样本；正向（NON_EC 引用论文池）与反向（EC 引用论文池）相互独立、非配对。q025/q50/q975 只是该重抽分布的分位区间，不是自动 95% 置信区间，也不承诺频率派覆盖；刊源选择、领域标注与参考文献解析的不确定性不在重抽模型内。2025 端点为右删失年份，其窗口结果须与 2024 端点并读。",
  "en": "Paper-level stratified bootstrap: citing papers are resampled with replacement within direction x year x source strata, each paper carrying its own edge counts and DOI-reference denominator together (edges are never independent samples); forward (NON_EC citing) and reverse (EC citing) pools are resampled independently and are not paired. q025/q50/q975 are percentile intervals of this resampling distribution only - NOT an automatic 95% confidence interval, with no frequentist coverage guarantee. Source selection, domain labeling and reference-parsing uncertainty lie outside the resampling model. 2025 is right-censored; read it next to the 2024 endpoint."
 },
 "spec": {
  "start_year": 2021,
  "windows": [
   "2021->2024",
   "2021->2025"
  ],
  "metrics": {
   "E1": "mean target edges per citing paper",
   "E2": "share of citing papers with >= 1 target edge",
   "E3": "mean share of DOI-resolved references pointing at the target; papers with zero DOI refs contribute 0.0 and stay in the denominators"
  },
  "strata": "direction x year x canonical source",
  "resampling_unit": "citing paper (edges and DOI-reference denominator resampled together)",
  "weighting": "fixed 2021 composition weights per direction over the support, renormalised over available strata",
  "pairing": "forward and reverse pools are non-paired; independent seeded RNG streams",
  "reps": 4000,
  "seed": 20261015,
  "seed_forward": [
   20261015,
   1
  ],
  "seed_reverse": [
   20261015,
   2
  ],
  "quantile_method": "linear interpolation",
  "e3_denominator": "COUNT(DISTINCT cited_doi) per citing paper"
 },
 "support": {
  "rule": "canonical source with non-empty paper pool in 2021, 2024 and 2025 in BOTH directions",
