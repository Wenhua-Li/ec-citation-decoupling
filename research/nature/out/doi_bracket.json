 "spec": {
  "support_rule": "non-empty paper pool in 2021/2024/2025 in both directions (registered 7-source common support)",
  "weights": "fixed 2021 composition weights per direction (main spec)",
  "bracket_level": "reference ROW level (unresolved rows = n_rows_all - n_rows_doi); conservative/outer",
  "queries": "exactly two SELECTs via ecdb.raw_sql (read-only URI); no writes",
  "interpretation": "worst-case bracket on the observables under extreme assignments of unresolved references; NOT a correction, imputation or re-weighting of the headline estimates",
  "tipping_point_semantics": "lambda = share of unresolved reference rows assigned to the target domain; E1/E3 use lambda*u continuously; E2 uses a per-paper threshold (a paper gains a target edge iff lambda*u >= 1), so the E2 flip point is stated in threshold semantics and is not directly comparable to E1/E3"
 }
